# Copy to .env and change values. Never commit .env.
MYSQL_DATABASE=trading
MYSQL_USER=trading
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Used when running the API outside Docker (uvicorn on your machine, DB from compose on :3307)
DATABASE_URL=mysql+pymysql://trading:change-me@localhost:3307/trading
CORS_ORIGINS=http://localhost:5173
